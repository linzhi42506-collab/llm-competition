<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>llm_comp</name>
  <version>0.1.0</version>
  <description>
    大模型技术创新赛（全球校园人工智能算法精英大赛·算法应用赛）参赛功能包：
    出题程序模拟 / 大模型任务解析 / 货物视觉识别 / 任务调度（导航+机械臂）/
    动态障碍物 / 可视化面板状态发布。
  </description>
  <maintainer email="team@example.com">llm_comp team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>linkattacher_msgs</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
